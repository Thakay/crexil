{
  "id": "raw-qwen-edit",
  "display_name": "Raw · Qwen Edit 2511",
  "description": "Max-retention instruction editing on Qwen-Image-Edit 2511: un-instructed content stays near-pixel-faithful. Edit-only — this engine always needs a source image.",
  "modality": "image",
  "model_family": "qwen-image-edit-2511",
  "workflows": {
    "img2img": "qwen-edit-2511@v1",
    "inpaint_modify": "qwen-edit-2511@v1",
    "inpaint_replace": "qwen-edit-2511@v1",
    "remove": "lama-remove@v1"
  },
  "default_candidates": 1,
  "defaults_note": "Deliberate tier: ~1–2 min per edit warm (measured). Recipe: 20 steps, cfg 4, shift 3.1. Retention comes from the source reference itself: there is no denoise strength to set. The output frame follows width/height (the engine works near 1024² total pixels internally).",
  "inputs": [
    {
      "key": "prompt",
      "label": "Instruction",
      "type": "text",
      "required": true,
      "default": "",
      "placeholder": "imperative works best — \"replace X with Y; keep everything else exactly the same\"",
      "target": { "node_title": "prompt_positive", "field": "prompt" }
    },
    {
      "key": "negative_prompt",
      "label": "Negative prompt",
      "type": "text",
      "default": "",
      "target": { "node_title": "prompt_negative", "field": "prompt" }
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": { "mode": "random" },
      "target": { "node_title": "sampler", "field": "seed" }
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 20,
      "min": 4,
      "max": 40,
      "target": { "node_title": "sampler", "field": "steps" }
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "default": 4.0,
      "min": 1.0,
      "max": 10.0,
      "step": 0.1,
      "target": { "node_title": "sampler", "field": "cfg" }
    },
    {
      "key": "width",
      "label": "Width",
      "type": "int",
      "default": 1024,
      "min": 512,
      "max": 2048,
      "step": 64,
      "target": { "node_title": "latent_size", "field": "width" }
    },
    {
      "key": "height",
      "label": "Height",
      "type": "int",
      "default": 1024,
      "min": 512,
      "max": 2048,
      "step": 64,
      "target": { "node_title": "latent_size", "field": "height" }
    }
  ]
}
