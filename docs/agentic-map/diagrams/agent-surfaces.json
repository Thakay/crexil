  "cards": [
    {
      "dot": "cyan",
      "title": "Who writes as whom",
      "items": [
        "Crexil app: human:<name>",
        "Voice director: agent:voice-director; the artist's clicks on its cards as human:<name>",
        "MCP server: agent:<name>, never a person",
        "CLI: the name --actor states, taken at its word, since Crexil has one local user and no accounts; these rules steer agents and are not a login"
      ]
    },
    {
      "dot": "rose",
      "title": "What stays the artist's",
      "items": [
        "403 to agents: reveal, deliver, change a project's or a sequence's limits",
        "403 to agents: start or end a voice session, resume held paid work",
        "Pick: recorded under whoever makes it (law 23); no agent tool offers one"
      ]
    },
    {
      "dot": "amber",
      "title": "Money gates",
      "items": [
        "Voice director runs alone only free, local work",
        "MCP server: its per-run limit, --max-run-usd, is $0 by default",
        "Server: every run states a cap; agents' paid work needs a project limit the artist set",
        "OpenRouter: priced by its live catalogue; a model priced at $0 passes a $0 limit"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "Sequences: built in the app; agents use HTTP or the CLI, at default limits",
        "The older canvas view (#/w): no per-run cap, no author"
      ]
    }
  ]
