    {
      "dot": "emerald",
      "title": "What the director decides",
      "items": [
        "Engines from list_engines, attempts, and its own preview line unless the artist gives one",
        "The run's cap: the artist's when named, else ten cents an attempt, said aloud first; the project's limit stays the artist's",
        "Starts a run alone only when it is free and every engine runs on this machine"
      ]
    },
    {
      "dot": "rose",
      "title": "What waits for the artist",
      "items": [
        "Starting the session: the artist's act, refused to agents",
        "Any paid run, or a free one that leaves the machine: a card with the price on the button",
        "A run over a cap, or at an unknown price: its card lists why, with no Run button"
      ]
    },
    {
      "dot": "amber",
      "title": "What stays off the model",
      "items": [
        "The ElevenLabs key: the browser gets only a short-lived token, handed over once",
        "File names, URLs and routes: tool answers are scrubbed or withheld"
