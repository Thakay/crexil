    {
      "dot": "cyan",
      "title": "One set of gates for every agent",
      "items": [
        "The voice director, the MCP server and a CLI run as agent all meet the same server rules",
        "The record names the author of every step: human:<name> or agent:<name>"
      ]
    },
    {
      "dot": "amber",
      "title": "What 'within caps' means for each",
      "items": [
        "Voice director: free, and every engine on this machine; anything else becomes a card",
        "MCP server: up to --max-run-usd ($0 default), restating the reviewed amount, and paid work only where the artist set a project limit",
        "CLI as agent: the server's caps, and paid work only where the artist set a project limit"
      ]
    },
    {
      "dot": "rose",
      "title": "What stays the artist's",
      "items": [
        "403: reveal, deliver, change limits",
        "403: start or end a voice session, resume held paid work",
        "Pick: recorded under whoever makes it (law 23); no agent tool offers one"
      ]
    }
