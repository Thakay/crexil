# Copy to .env and fill in. .env is git-ignored and is never baked into an image.
# Everything here describes your installation: your folders, your keys.

# --- the hand-off folder: where a delivery or a promotion copies the chosen takes ---
# Unset, it is crexil-handoff in your home folder. The server never creates it, so make the
# folder first, or set an absolute path of your own; under WSL that is often a folder on a
# Windows drive, written in its /mnt form.
# PROMOTE_ROOTS (optional, colon-separated) fences where a re-point may go; unset, the fence
# is the hand-off folder itself. compose.yaml also reads PROMOTE_MOUNT, the folder it mounts
# at the same path inside the container: the hand-off folder unless set.
# PROMOTE_DIR=
# PROMOTE_ROOTS=
# PROMOTE_MOUNT=

# --- runtime ---
COMFYUI_URL=http://127.0.0.1:8188
THREED_URL=http://127.0.0.1:8189
# The one store. Defaults to cockpit/server/cockpit-v4.sqlite in the checkout; set an
# absolute path to keep it elsewhere. The server upgrades schema 4 and later in place;
# a file older than schema 4 is refused (SchemaVersionError), never migrated or overwritten.
# COCKPIT_DB=/absolute/path/to/cockpit-v4.sqlite
# Where model weights live (read-only to the application; used for manifest hashing).
# MODELS_ROOT=~/models

# --- external providers (the external lane disables itself when the key is absent) ---
# One key through OpenRouter (prepaid credits at openrouter.ai).
# The model list and price estimates live in providers.json.
OPENROUTER_API_KEY=
# ElevenLabs speech, Voice Design and sound effects. The key stays in the environment and is
# never stored. The audio engines are rows of configs/engines.json; enable them there.
ELEVENLABS_API_KEY=
# The local voice runner (tools/tts) when it is installed.
# VOICE_RUNNER_URL=http://127.0.0.1:8190
# The voice director, a voice agent built on ElevenAgents. 0 minutes starts no session;
# set a cap to allow one.
# ELEVENLABS_VOICE_AGENT_ID=
# CREXIL_VOICE_MINUTES_CAP=0
# CREXIL_VOICE_SESSION_MAX_S=300

# --- Hugging Face (gated model downloads, including the 3D lane's gated conditioner) ---
# Export HF_TOKEN in your shell instead: the downloader and the 3D tools read the
# process environment, not this file. `hf auth login` works too.
